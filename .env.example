META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Enforced at discovery, ensemble selection and the provider call boundary.
AGENTWARD_META_ONLY=1
ENSEMBLE_MODE=meta_only
AGY_SELECTED_MODEL=gemini-4-argon
# AGY_BIN=/absolute/path/to/agy
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=openai/gpt-6-astra
CUSTOM_REASONING_EFFORT=medium
# Optional, only for endpoints that support it: fast or ultrafast
CUSTOM_SERVICE_TIER=
AGENTWARD_INGRESS_URL=http://127.0.0.1:18000/scan-ingress
# Required in this file: e.g. http://YOUR_NODE_TAILSCALE_IP:8001
# /health, /execute and /run-sandbox-test are constructed from this one URL.
AGENTWARD_SANDBOX_URL=
AGENTWARD_FORCE_LOCAL=0
# Same random secret (at least 32 characters) as /etc/agentward/node.env on the node.
AGENTWARD_NODE_TOKEN=
# Exact hostnames accepted by HTTP and WebSocket routes; no wildcard entries.
DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,::1
AI_TIMEOUT_S=120
AGY_TIMEOUT_S=180
AGY_PREFLIGHT_TIMEOUT_S=30
