FROM node:24-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends strace libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
# The node starts a trusted tracer as root and drops payload UID/GID in its
# immutable bootstrap. Never invoke this image directly with untrusted code.
