[Unit]
Description=AgentWard Ingress Ingress guard Service (Stage 1)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agentward-node
Environment="PATH=/home/ubuntu/agentward-node/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/agentward/node.env
# AGENTWARD_SANDBOX_URL is required in the application's .env.
ExecStart=/home/ubuntu/agentward-node/venv/bin/uvicorn ingress_server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
